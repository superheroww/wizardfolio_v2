{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wizardfolio.com/schemas/fund.schema.json",
  "title": "WizardFolio normalized fund",
  "type": "object",
  "required": ["schemaVersion", "id", "symbol", "exchange", "currency", "issuer", "holdingsDate", "retrievedAt", "sourceUrl", "coverageWeight", "quality", "holdings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string" },
    "symbol": { "type": "string" },
    "exchange": { "type": "string" },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
    "holdingsDate": { "type": "string", "format": "date" },
    "retrievedAt": { "type": "string", "format": "date-time" },
    "sourceUrl": { "type": "string", "format": "uri" },
    "coverageWeight": { "type": "number", "minimum": 0, "maximum": 102 },
    "quality": { "enum": ["complete", "near-complete", "partial", "unavailable", "stale", "failed"] },
    "holdings": {
      "type": "array",
      "items": { "$ref": "security.schema.json" }
    }
  },
  "additionalProperties": true
}
